{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
    "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  
  
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/renew-scholarships",
      "schedule": "0 0 * * *"
    }
  ]
}
